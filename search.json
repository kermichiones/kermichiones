---
layout: null
permalink: /search.json
sitemap: false
---
{% assign items = site.posts | concat: site.projects | sort: 'date' | reverse %}
[
{% for item in items %}
  {
    "title": {{ item.title | default: "Başlıksız" | jsonify }},
    "url": {{ item.url | jsonify }},
    "collection": {{ item.collection | default: "posts" | jsonify }},
    "date": {{ item.date | date: "%Y-%m-%d" | jsonify }},
    "year": {{ item.date | date: "%Y" | jsonify }},
    "month": {{ item.date | date: "%m" | jsonify }},
    "author": {{ item.author | default: site.author.name | jsonify }},
    "tags": {{ item.tags | jsonify }},
    "categories": {{ item.categories | jsonify }},
    "description": {{ item.description | jsonify }},
    "image": {{ item.image | jsonify }},
    "body": {{ item.content | strip_html | normalize_whitespace | truncate: 1500 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
